# Copy to .env.local and fill in. Never commit .env.local.

# Postgres — Neon, Supabase, or any Postgres 13+.
# Supabase: use the *transaction pooler* URL for serverless deploys.
DATABASE_URL=postgres://user:password@host:5432/dbname

# KIE API key — https://kie.ai/api-key
# Server-side only. Never expose this to the browser.
KIE_API_KEY=

# Optional: force the mock generation driver even when a key is present.
# Any value other than "mock" (or unset) uses the real API.
KIE_DRIVER=

# Optional: override the API base.
# KIE_BASE_URL=https://api.kie.ai

# Optional: public origin used to build the KIE completion callback URL.
# Without it the platform falls back to polling, which works fine.
# PUBLIC_BASE_URL=https://your-deployment.example.com

# Optional: shared secret required on the callback (?token=...).
# Set this whenever PUBLIC_BASE_URL is set — KIE does not sign callbacks.
# KIE_WEBHOOK_SECRET=

# --- RIP pipeline ---

# Anthropic API key — powers reference analysis (vision) and concept drafting.
# Get one at https://console.anthropic.com/settings/keys
# Without it the platform runs a mock analysis driver.
ANTHROPIC_API_KEY=

# Optional: override the analysis model (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Optional: force the mock analysis driver even when a key is present.
ANALYSIS_DRIVER=

# Vercel Blob — hosts uploaded reference/product images and mirrors generated
# assets off KIE's expiring tempfile.aiquickdraw.com URLs.
BLOB_READ_WRITE_TOKEN=

# Analysis routing: anthropic | kie | mock
# Auto: anthropic if ANTHROPIC_API_KEY is set, else mock.
# Set to "kie" once Claude models are enabled on your KIE key — one vendor,
# one bill. Verify first with: npm run kie:claude-probe
ANALYSIS_DRIVER=

# Claude model to use when ANALYSIS_DRIVER=kie.
# KIE_ANALYSIS_MODEL=claude-sonnet-5

# --- Access control ---
# Both required to enable the sign-in gate. With either unset every page is
# open to anyone who can reach the URL.
# APP_PASSWORD is the shared password; AUTH_SECRET signs the session cookie
# (any long random string — `openssl rand -base64 32`).
APP_PASSWORD=
AUTH_SECRET=
